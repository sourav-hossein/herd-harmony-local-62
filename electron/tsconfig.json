{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "paths": {
      "@herd-harmony/shared-types/*": ["../packages/shared-types/dist/*"]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.cjs", "../packages/shared-types/dist/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
